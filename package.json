{
  "name": "unofficial-novelpia-patch",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "description": "노벨피아 뷰어의 읽기 환경을 개선하는 비공식 Chrome 확장프로그램",
  "license": "MIT",
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "dev": "wxt",
    "icons:generate": "node scripts/generate-icons.mjs",
    "prepare": "wxt prepare",
    "build": "pnpm run type-check && wxt build",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "type-check": "wxt prepare && tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "pnpm run build:e2e && playwright test",
    "test:release": "node --test scripts/release-*.test.mjs scripts/cws-*.test.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:package": "node scripts/release-package.mjs",
    "cws:status": "node scripts/cws-release.mjs status",
    "cws:submit": "node scripts/cws-release.mjs submit",
    "lint": "eslint src tests scripts modules *.config.*",
    "format": "prettier --write src tests scripts modules *.config.* .github README.md CONTRIBUTING.md CHANGELOG.md SECURITY.md docs store/**/*.md package.json pnpm-workspace.yaml .prettierrc.json",
    "format:check": "prettier --check src tests scripts modules *.config.* .github README.md CONTRIBUTING.md CHANGELOG.md SECURITY.md docs store/**/*.md package.json pnpm-workspace.yaml .prettierrc.json"
  },
  "dependencies": {
    "fontkit": "2.0.4",
    "motion": "14.0.0",
    "page-flip": "2.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wxt": "0.21.4",
    "yaml": "2.8.3"
  }
}
